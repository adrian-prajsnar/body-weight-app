---
import { marked } from 'marked';
import { dateLocale, getMessages, type SiteLocale } from '../i18n';
import { getReleases, notesFor } from '../lib/releases';

type Props = { locale: SiteLocale };
const { locale } = Astro.props;
const t = getMessages(locale);
const releases = getReleases();
const dateFmt = new Intl.DateTimeFormat(dateLocale(locale), {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

function formatDate(value: string) {
  if (!value) return '';
  const date = new Date(`${value}T00:00:00Z`);
  return Number.isNaN(date.getTime()) ? value : dateFmt.format(date);
}
---

<section class="page-hero">
  <div class="section-inner is-visible" data-reveal>
    <h1>{t.releases.title}</h1>
    <p class="section-lead">{t.releases.subtitle}</p>
  </div>
</section>

<section class="section">
  <div class="section-inner">
    {
      releases.length === 0 ? (
        <p class="card" data-reveal>{t.releases.empty}</p>
      ) : (
        <div class="release-list">
          {releases.map((release, index) => {
            const isLatest = index === 0;
            const html = marked.parse(notesFor(release, locale), { async: false }) as string;
            return (
              <article
                class:list={['release-card', isLatest && 'is-latest']}
                data-reveal
                style={`--reveal-delay: ${index * 80}ms`}
              >
                <div class="release-head">
                  <div>
                    <h2 class="release-version">
                      {release.version}
                      {isLatest && <span class="latest-badge">{t.releases.latest}</span>}
                    </h2>
                    <p class="release-date">{formatDate(release.date)}</p>
                  </div>
                  {isLatest && release.apkUrl ? (
                    <a class="btn btn-primary" href={release.apkUrl}>
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 4v12M7 11l5 5 5-5M5 20h14"></path>
                      </svg>
                      <span>{t.releases.download}</span>
                    </a>
                  ) : isLatest ? (
                    <p class="version-chip">{t.releases.noApk}</p>
                  ) : null}
                </div>
                <div class="release-notes" set:html={html} />
              </article>
            );
          })}
        </div>
      )
    }
  </div>
</section>
